#!/bin/bash
echo "jseval -q (function(){ \
  var sel = window.getSelection(); \
  if (!sel.rangeCount) return; \
  var range = sel.getRangeAt(0); \
  var mark = document.createElement('mark'); \
  mark.className = 'qute-hl'; \
  mark.style.backgroundColor = '#f7ca88'; \
  mark.style.color = '#181818'; \
  mark.style.borderRadius = '2px'; \
  try { range.surroundContents(mark); } catch(e) { return; } \
  window._qhIdx = document.querySelectorAll('.qute-hl').length - 1; \
})();" >> "$QUTE_FIFO"
